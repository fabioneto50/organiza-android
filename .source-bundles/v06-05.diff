--- a/app/src/test/java/com/organiza/app/domain/SaluQuoteEngineTest.kt
+++ b/app/src/test/java/com/organiza/app/domain/SaluQuoteEngineTest.kt
@@ -0,0 +1,42 @@
+package com.organiza.app.domain
+
+import com.organiza.app.model.AppData
+import com.organiza.app.model.Shift
+import com.organiza.app.model.ShiftType
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.LocalDate
+
+class SaluQuoteEngineTest {
+    @Test
+    fun sameDateProducesSameQuote() {
+        val date = LocalDate.of(2026, 8, 21)
+        val data = AppData()
+        val first = SaluQuoteEngine.select(data, effectiveEnergy = 3, date = date)
+        val second = SaluQuoteEngine.select(data, effectiveEnergy = 3, date = date)
+        assertEquals(first, second)
+    }
+
+    @Test
+    fun consecutiveDaysRotateQuoteOnSameContext() {
+        val data = AppData()
+        val first = SaluQuoteEngine.select(data, 3, LocalDate.of(2026, 8, 21))
+        val second = SaluQuoteEngine.select(data, 3, LocalDate.of(2026, 8, 22))
+        assertNotEquals(first, second)
+    }
+
+    @Test
+    fun lowEnergyUsesGentleMessage() {
+        val date = LocalDate.of(2026, 8, 21)
+        val data = AppData(
+            shifts = listOf(
+                Shift(date = date.minusDays(1).toString(), type = ShiftType.NOITE, startTime = "20:00", endTime = "08:00")
+            )
+        )
+        val quote = SaluQuoteEngine.select(data, effectiveEnergy = 1, date = date)
+        assertTrue(quote.isNotBlank())
+        assertTrue(quote.length < 120)
+    }
+}
